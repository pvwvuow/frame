generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Title {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  titleEn       String
  type          String // 'movie' | 'series'
  year          Int
  rating        Float     @default(0)
  duration      Int       @default(0) // minutes (movie) or avg episode
  description   String
  genres        String    @default("[]") // JSON string[]
  poster        String
  backdrop      String
  videoUrl      String
  trailerUrl    String?
  director      String    @default("")
  cast          String    @default("[]") // JSON string[]
  country       String    @default("ایران")
  ageRating     String    @default("+13")
  quality       String    @default("4K")
  featured      Boolean   @default(false)
  trendingScore Int       @default(0)
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  episodes      Episode[]
  reviews       Review[]
  watchlist     Watchlist[]
  favorites     Favorite[]
  progress      WatchProgress[]
  ratings       UserRating[]

  @@index([type])
  @@index([trendingScore])
}

model Episode {
  id         Int             @id @default(autoincrement())
  titleId    Int
  title      Title           @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season     Int             @default(1)
  number     Int
  name       String
  synopsis   String          @default("")
  duration   Int             @default(45)
  videoUrl   String
  thumbnail  String
  progress   WatchProgress[]

  @@index([titleId])
}

/// "لیست من" – هر عنوان یک وضعیت، یادداشت و اولویت دارد
model Watchlist {
  id        Int      @id @default(autoincrement())
  userKey   String
  titleId   Int
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  status    String   @default("planned") // planned | watching | watched
  note      String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userKey, titleId])
  @@index([userKey, status])
}

/// علاقه‌مندی‌ها (قلب) – مستقل از لیست تماشا
model Favorite {
  id        Int      @id @default(autoincrement())
  userKey   String
  titleId   Int
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userKey, titleId])
  @@index([userKey])
}

/// امتیاز شخصی کاربر به هر عنوان (۱ تا ۱۰)
model UserRating {
  id        Int      @id @default(autoincrement())
  userKey   String
  titleId   Int
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userKey, titleId])
}

model WatchProgress {
  id        Int      @id @default(autoincrement())
  userKey   String
  titleId   Int
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodeId Int?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  position  Float    @default(0)
  duration  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userKey, titleId])
  @@index([userKey, updatedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  titleId   Int
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@index([titleId])
}

/// پروفایل و تنظیمات کاربر
model UserProfile {
  id            Int      @id @default(autoincrement())
  userKey       String   @unique
  displayName   String   @default("کاربر نما")
  avatar        Int      @default(0)
  autoplay      Boolean  @default(true)
  autoNext      Boolean  @default(true)
  quality       String   @default("auto") // auto | 4k | 1080p | 720p | 480p
  subtitle      String   @default("fa") // fa | en | off
  matureContent Boolean  @default(true)
  reduceMotion  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}
