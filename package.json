{
  "name": "frame",
  "version": "0.10.10",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build --webpack && node scripts/postbuild.cjs",
    "verify": "npx tsc --noEmit && node scripts/preflight.mjs && node scripts/test-startup-fixes.mjs && node scripts/test-stream-proxy.mjs",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "electron:dev": "npm run electron:bundle && cross-env NAMA_DEV_URL=http://localhost:3000 electron .",
    "electron:start": "npm run electron:bundle && cross-env NAMA_USE_DEV_SERVER=0 electron .",
    "electron:pack": "npm run electron:bundle && electron-builder --dir",
    "electron:build": "npm run electron:bundle && electron-builder --publish never",
    "electron:build:win": "npm run electron:bundle && electron-builder --win --publish never",
    "electron:build:mac": "npm run electron:bundle && electron-builder --mac --publish never",
    "electron:build:linux": "npm run electron:bundle && electron-builder --linux --publish never",
    "electron:release": "npm run electron:bundle && electron-builder --publish always",
    "desktop": "npm run build && npm run electron:build",
    "electron:bundle": "node scripts/bundle-electron.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
