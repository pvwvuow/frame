!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/icon.png
/release/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env.*.local

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# workspace / internal artifacts (not part of the app)
/scripts/*
!/scripts/postbuild.cjs
!/scripts/bundle-electron.cjs
!/scripts/electron-after-pack.cjs
!/scripts/mock-od
!/scripts/test-parser.ts
